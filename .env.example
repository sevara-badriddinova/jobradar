# Copy this file to .env and fill in only what you use. Never commit .env.
# Load it in each terminal with: set -a; source .env; set +a

# Database (matches compose.yaml). For the cloud setup, see docs/12-cloud-run.md.
JOBRADAR_DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5433/jobradar
# Used by integration tests only. They're skipped when this is unset.
JOBRADAR_TEST_DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5433/jobradar_test

# AI matching: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram alerts: see docs/08-telegram.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional application tracking (Notion is preferred when configured)
# NOTION_TOKEN=
# NOTION_DATA_SOURCE_ID=
# Or use a database ID / URL if that database has exactly one data source:
# NOTION_DATABASE_ID=
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
