JOBRADAR_DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5433/jobradar
# Cloud: use the direct Neon URL with sslmode=require (no -pooler hostname).
# Standard postgresql:// URLs are accepted. See docs/12-cloud-run.md.
# Used by tests that need a real database; they're skipped when unset.
JOBRADAR_TEST_DATABASE_URL=postgresql+psycopg://jobradar:jobradar@localhost:5433/jobradar_test

# Optional application sources. applications sync prefers Notion when configured.
# Copy to .env, fill in locally, then: set -a; source .env; set +a
# NOTION_TOKEN=
# NOTION_DATA_SOURCE_ID=
# Or use a database ID / URL if that database has exactly one data source:
# NOTION_DATABASE_ID=
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD='abcdefghijklmnop'
# ANTHROPIC_API_KEY=
# JOBRADAR_INBOX_MODEL=claude-haiku-4-5-20251001
